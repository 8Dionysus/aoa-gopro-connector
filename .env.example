# Portable defaults use .connector-state for tiny network-free runs.
# Set an external instance root before live media or sustained operation.

# AOA_GOPRO_INSTANCE_ROOT=/path/to/aoa-gopro-connector
# AOA_GOPRO_DATA_ROOT=${AOA_GOPRO_INSTANCE_ROOT}/data
# AOA_GOPRO_CACHE_ROOT=${AOA_GOPRO_INSTANCE_ROOT}/cache
# AOA_GOPRO_AUTH_ROOT=${AOA_GOPRO_INSTANCE_ROOT}/auth
# AOA_GOPRO_ARTIFACT_ROOT=${AOA_GOPRO_INSTANCE_ROOT}/artifacts
# AOA_GOPRO_MEDIA_ROOT=${AOA_GOPRO_INSTANCE_ROOT}/media
