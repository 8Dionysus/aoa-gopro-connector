{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/aoa-gopro-connector/schemas/capability_profile.schema.json",
  "title": "AoA GoPro capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_digest",
    "observed_at",
    "posture",
    "device_ref",
    "camera",
    "transport",
    "api",
    "observations",
    "capabilities",
    "sdk",
    "privacy",
    "limitations",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "aoa_gopro_capability_profile_v1"},
    "profile_id": {"type": "string", "pattern": "^gopro-[a-z0-9][a-z0-9.-]+$"},
    "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "posture": {"enum": ["sanitized_replay", "live_read_only"]},
    "device_ref": {"const": "device:redacted"},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "model_number",
        "firmware_vendor_version",
        "firmware_release_version",
        "firmware_posture"
      ],
      "properties": {
        "model_name": {
          "type": "string",
          "pattern": "^(HERO([0-9]{1,2})?( Black( Mini)?)?|MAX( ?[0-9])?|LIT HERO)$"
        },
        "model_number": {"type": "string", "pattern": "^[0-9]{1,6}$"},
        "firmware_vendor_version": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,7}(\\.[0-9]{1,4}){3,6}$"
        },
        "firmware_release_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2,4}\\.[0-9]{2,4}$"
        },
        "firmware_posture": {"enum": ["stock", "labs", "unknown"]}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "discovery", "http_read"],
      "properties": {
        "topology": {"enum": ["usb_ncm_http", "wifi_ap_http", "cohn_http"]},
        "discovery": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ble",
              "cohn_registry",
              "manual",
              "mdns",
              "replay",
              "usb",
              "wifi_scan"
            ]
          }
        },
        "http_read": {"const": "observed"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "spec_version", "protocol_version"],
      "properties": {
        "family": {"const": "OpenGoPro"},
        "spec_version": {"type": "string", "minLength": 1},
        "protocol_version": {
          "type": "string",
          "pattern": "^(unknown|[0-9]{1,3}(\\.[0-9]{1,3}){0,2})$"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_key_count",
        "setting_key_count",
        "media_group_count",
        "media_item_count"
      ],
      "properties": {
        "status_key_count": {"type": "integer", "minimum": 0},
        "setting_key_count": {"type": "integer", "minimum": 0},
        "media_group_count": {"type": "integer", "minimum": 0},
        "media_item_count": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_camera_info",
        "read_camera_state",
        "list_media",
        "ble_discovery_and_wake",
        "wifi_ap_control",
        "cohn_control",
        "camera_effects",
        "preview",
        "recording",
        "hilight",
        "media_transfer",
        "gpmf",
        "disconnect_recovery"
      ],
      "properties": {
        "read_camera_info": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "read_camera_state": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "list_media": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "ble_discovery_and_wake": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "wifi_ap_control": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "cohn_control": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "camera_effects": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "preview": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "recording": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "hilight": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "media_transfer": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "gpmf": {"enum": ["observed", "not_observed", "unsupported", "unknown"]},
        "disconnect_recovery": {"enum": ["observed", "not_observed", "unsupported", "unknown"]}
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_version",
        "declared_python",
        "posture"
      ],
      "properties": {
        "published_version": {"type": "string", "minLength": 1},
        "declared_python": {"type": "string", "minLength": 1},
        "posture": {"const": "optional_adapter"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_responses_retained",
        "device_identifiers_retained",
        "network_identity_retained",
        "media_names_retained"
      ],
      "properties": {
        "raw_responses_retained": {"const": false},
        "device_identifiers_retained": {"const": false},
        "network_identity_retained": {"const": false},
        "media_names_retained": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "https://gopro.github.io/OpenGoPro/"},
        {"const": "https://gopro.github.io/OpenGoPro/http_2_0"},
        {
          "oneOf": [
            {
              "enum": [
                "local-live-read-only:operator-authorized-camera",
                "local-live-read-only:hero13-stock-usb-ncm-phase0-20260829"
              ]
            },
            {"type": "string", "pattern": "^fixture:sha256:[0-9a-f]{64}$"}
          ]
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"posture": {"const": "sanitized_replay"}}},
      "then": {
        "properties": {
          "evidence_refs": {
            "prefixItems": [
              {},
              {},
              {"type": "string", "pattern": "^fixture:sha256:[0-9a-f]{64}$"}
            ]
          }
        }
      },
      "else": {
        "properties": {
          "evidence_refs": {
            "prefixItems": [
              {},
              {},
              {
                "enum": [
                  "local-live-read-only:operator-authorized-camera",
                  "local-live-read-only:hero13-stock-usb-ncm-phase0-20260829"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
